def plus_proche():
    dist_min = distance(0, 1)
    ind_i = 0
    ind_j = 1
    for i in range(len(coords_x)):
        for j in range(i+1, len(coords_y)):
            if distance(i, j) < dist_min:
                dist_min = distance(i, j)
                ind_i = i
                ind_j = j
    return (ind_i, ind_j)

