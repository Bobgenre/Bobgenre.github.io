2.1)
Select id
From users
Where numTel = 0123456789

2.2)
Select count(id)
From users
Group By numTel

2.3)
Select traces.latitude, traces.longitude
From traces
Join users on users.id = traces.id
Where users.numTel = 0123456789

2.4)
Select count(traces.latitude)
From traces
join users on users.id = traces.id
group by users.numTel

2.5)
Select count(*)
From users
join traces on users.id = traces.id
group by users.numTel
Having count(*) > 1000

