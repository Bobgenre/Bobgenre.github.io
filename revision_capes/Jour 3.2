def sous_cluster(cl, x_min, x_max):
    sous_cl = [[]]
    ind_enlever = []
    ind_x_max = 0
    ind_x_min = 0

    for i in range(len(cl[0])):
        if cl[0][i] == x_min:
            ind_x_min = i
        if cl[0][i] == x_max:
            ind_x_max = i
    
    for i in range(ind_x_min, ind_x_max+1):
        sous_cl[0].append(cl[0][i])

    for i in range(len(sous_cl[0])):
        if cl[1][i] in sous_cl[0]:
            sous_cl[1].append(cl[1][i])

    return sous_cl

