def Dist(G, s):
    f = deque([s])
    vue = set([s])
    d = {s: 0}

    while f:
        x = f.popleft()

        for y in G[x]:
            if y not in vue:
                vue.add(y)
                f.append(y)
                d[y] = d[x] + 1

    return d

