def SommetProxMax(G):
    max_centralite = -1
    sommet_max = -1

    for k,v in G.items():
        d = Dist(G, k)
        somme_dist = 0

        for v in d.values():
            somme_dist += v

        if somme_dist > 0:
            centralite = 1 / somme_dist
            if centralite > max_centralite:
                max_centralite = centralite
                sommet_max = k
      
    
    return sommet_max

