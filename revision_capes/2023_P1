def zero_sur_lignes(mat):
    zero = False
    for i in range(len(mat)):
        j = 0
        while j < len(mat[i]) and zero == False: 
            if mat[i][j] == 0:
                zero = True
            j += 1
        if zero == False:
            return False
        zero = False
    return True

