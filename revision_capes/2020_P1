5) On peut utiliser un dictionnaire pour stocker sans répétition

6) 
def liste_mots(S, n, l):
    dico = {}
    lst = []
    mot = ""
    for i in range(n-l+1):
        for j in range(i, i+l):
            mot += S[j]
        dico[mot] = 1
        mot = ""
    for k in dico.keys():
        lst.append(k)
    return lst