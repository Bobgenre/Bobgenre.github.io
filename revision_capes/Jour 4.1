def distance_minimale(cl):
    n = len(cl[0])
    dist_min = distance(cl[0][0], cl[0][1])

    if n < 4:
        return fusion(cl, dist_min)

    g = gauche(cl)
    d = droite(cl)
    d0 = min(distance_minimale(g), distance_minimale(d))
    
    bande = bande_centrale(cl, d0)

    return fusion(bande, d0)

