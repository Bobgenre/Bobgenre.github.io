def fusion(cl, d0):
    dist_min = d0
    n = len(cl[0])
    for i in range(n-1):
        test_dist = distance(cl[0][i], cl[0][i+1])
        if test_dist < dist_min:
            dist_min = test_dist
    return dist_min

